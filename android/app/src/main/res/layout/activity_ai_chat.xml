<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Cyber Deck Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#071007"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="#0D260F"
            android:fontFamily="monospace"
            android:minWidth="60dp"
            android:paddingHorizontal="10dp"
            android:text="&lt; BACK"
            android:textColor="#00FF41"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="AI OFFLINE // CYBER DECK"
                android:textColor="#00FF41"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvActiveModel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="Model Aktif: Belum Ada"
                android:textColor="#78E891"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnPickFile"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="#0D260F"
            android:fontFamily="monospace"
            android:paddingHorizontal="10dp"
            android:text="PILIH .GGUF"
            android:textColor="#00FF41"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSelectFolder"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="#0D260F"
            android:fontFamily="monospace"
            android:paddingHorizontal="10dp"
            android:text="PILIH FOLDER"
            android:textColor="#00FF41"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnClearChat"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="#260D0D"
            android:fontFamily="monospace"
            android:paddingHorizontal="10dp"
            android:text="CLEAR CHAT"
            android:textColor="#FF5555"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Model Status Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="#050A05"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp">

        <TextView
            android:id="@+id/tvModelStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:text="MODEL: BELUM DIMUAT"
            android:textColor="#00FF41"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLoadMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="100% OFFLINE • SAF FD"
            android:textColor="#479E59"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Missing Folder / GGUF Banner -->
    <LinearLayout
        android:id="@+id/layoutMissingFolder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#1A0E05"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvMissingFolderMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:text="Folder AI_Models tidak ditemukan. Pilih folder AI_Models di SSD Anda"
            android:textColor="#FFB84D"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnPickFilePrompt"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#0D260F"
            android:fontFamily="monospace"
            android:paddingHorizontal="10dp"
            android:text="PILIH .GGUF"
            android:textColor="#00FF41"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPickFolderPrompt"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#00FF41"
            android:fontFamily="monospace"
            android:paddingHorizontal="12dp"
            android:text="PILIH FOLDER"
            android:textColor="#000000"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Chat History RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChatHistory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="#030603"
        android:clipToPadding="false"
        android:padding="8dp"
        android:scrollbars="vertical" />

    <!-- Prompt Input Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#071007"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <EditText
            android:id="@+id/etPrompt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#020502"
            android:fontFamily="monospace"
            android:hint="Ketik prompt ke AI Cyber Deck..."
            android:imeOptions="actionSend"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:minHeight="44dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:textColor="#00FF41"
            android:textColorHint="#3A7A49"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#3B1111"
            android:fontFamily="monospace"
            android:paddingHorizontal="12dp"
            android:text="STOP"
            android:textColor="#FF6B6B"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnSend"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#00FF41"
            android:fontFamily="monospace"
            android:paddingHorizontal="16dp"
            android:text="SEND"
            android:textColor="#000000"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
